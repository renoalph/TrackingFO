{
  "version": 2,
  "cleanUrls": true,
  "rewrites": [
    {
      "source": "/",
      "destination": "/tbig-shipment/index.html"
    },
    {
      "source": "/cme",
      "destination": "/tracking-cme/index.html"
    },
    {
      "source": "/cme/(.*)",
      "destination": "/tracking-cme/$1"
    },
    {
      "source": "/shipment",
      "destination": "/tbig-shipment/index.html"
    },
    {
      "source": "/shipment/(.*)",
      "destination": "/tbig-shipment/$1"
    },
    {
      "source": "/logistik",
      "destination": "/tbig-shipment/index.html"
    },
    {
      "source": "/logistik/(.*)",
      "destination": "/tbig-shipment/$1"
    },
    {
      "source": "/(.*)",
      "destination": "/tbig-shipment/$1"
    }
  ]
}
